/*
IPL Analysis Dashboard — DAX starter measures
Tables: Matches, Deliveries
The column names below match scripts/build_cricsheet_data.py.
Create a disconnected Teams table using:
Teams =
DISTINCT (
    UNION (
        SELECTCOLUMNS ( Matches, "team", Matches[team1] ),
        SELECTCOLUMNS ( Matches, "team", Matches[team2] )
    )
)
Use Teams[team] for team-level slicers and axes.
*/

Total Matches =
DISTINCTCOUNT ( Matches[match_id] )

Matches With Result =
CALCULATE (
    DISTINCTCOUNT ( Matches[match_id] ),
    NOT ISBLANK ( Matches[winner] )
)

Total Runs =
CALCULATE (
    SUM ( Deliveries[total_runs] ),
    Deliveries[is_super_over] = 0
)

Batter Runs =
CALCULATE (
    SUM ( Deliveries[batter_runs] ),
    Deliveries[is_super_over] = 0
)

Wicket Events =
CALCULATE (
    SUM ( Deliveries[is_wicket] ),
    Deliveries[is_super_over] = 0
)

Bowler Credit Wickets =
CALCULATE (
    SUM ( Deliveries[is_bowler_credit_wicket] ),
    Deliveries[is_super_over] = 0
)

Legal Balls =
CALCULATE (
    SUM ( Deliveries[is_legal_ball] ),
    Deliveries[is_super_over] = 0
)

Batter Balls Faced =
CALCULATE (
    SUM ( Deliveries[batter_ball_faced] ),
    Deliveries[is_super_over] = 0
)

Batting Strike Rate =
DIVIDE ( [Batter Runs] * 100, [Batter Balls Faced], 0 )

Bowler Runs Conceded =
CALCULATE (
    SUM ( Deliveries[bowler_runs] ),
    Deliveries[is_super_over] = 0
)

Bowling Economy =
DIVIDE ( [Bowler Runs Conceded] * 6, [Legal Balls], 0 )

Team Wins =
VAR SelectedTeam = SELECTEDVALUE ( Teams[team] )
RETURN
CALCULATE (
    DISTINCTCOUNT ( Matches[match_id] ),
    FILTER ( ALL ( Matches ), Matches[winner] = SelectedTeam )
)

Team Matches Played =
VAR SelectedTeam = SELECTEDVALUE ( Teams[team] )
RETURN
CALCULATE (
    DISTINCTCOUNT ( Matches[match_id] ),
    FILTER (
        ALL ( Matches ),
        Matches[team1] = SelectedTeam
            || Matches[team2] = SelectedTeam
    )
)

Team Win Percentage =
DIVIDE ( [Team Wins], [Team Matches Played], 0 ) * 100

Toss Wins =
CALCULATE (
    DISTINCTCOUNT ( Matches[match_id] ),
    NOT ISBLANK ( Matches[toss_winner] )
)

Toss Winner Also Won =
CALCULATE (
    DISTINCTCOUNT ( Matches[match_id] ),
    FILTER (
        Matches,
        NOT ISBLANK ( Matches[toss_winner] )
            && Matches[toss_winner] = Matches[winner]
    )
)

Toss Conversion Percentage =
DIVIDE ( [Toss Winner Also Won], [Toss Wins], 0 ) * 100

Matches Batting First =
CALCULATE (
    DISTINCTCOUNT ( Matches[match_id] ),
    Matches[toss_decision] = "bat"
)

Matches Choosing Field =
CALCULATE (
    DISTINCTCOUNT ( Matches[match_id] ),
    Matches[toss_decision] = "field"
)

-- For batting/bowling leaderboards, place Deliveries[batter] or
-- Deliveries[bowler] on the visual axis and apply a sensible minimum
-- balls-faced / legal-balls filter before comparing rates.
